# Copy to .env (chmod 600 .env) and fill in. Never commit .env.

# The public address people use (QR codes and login links are built from it). Must be https in production.
PUBLIC_URL=https://gameshow.sathyasai.org

# Gemini (AI grouping). The key stays on the server; browsers never see it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Created as admins on every start (your name or email). Then run:  docker compose exec app node src/cli.js login-link <name>
ADMIN_IDS=admin

# Email sign-in (Microsoft 365 / Office 365). People type their email on the login page and get a one-time link.
# Leave SMTP_USER empty to turn it off (CLI login links still work). Check it with:  docker compose exec app node src/cli.js mail-test you@example.org
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Must be the mailbox above (or one it may "send as"). Defaults to SMTP_USER.
SMTP_FROM=
SMTP_FROM_NAME=One Sai Family game show
EMAIL_LINK_TTL_MIN=15      # links people request for themselves
INVITE_TTL_HOURS=24        # links an admin emails to a new person


# Optional. If empty, a random secret is generated once and kept in the data volume.
SESSION_SECRET=
