# Copy to .env (chmod 600 .env) and fill in. Never commit .env.

# The public address people use (QR codes and login links are built from it). Must be https in production.
PUBLIC_URL=https://game.example.org

# Gemini (AI grouping). The key stays on the server; browsers never see it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Created as admins on every start (name or email). Then run:  docker compose exec app node src/cli.js login-link <name>
ADMIN_IDS=ritesh

# Name of the Docker network your Caddy container is attached to (docker network ls)
CADDY_NETWORK=caddy

# Optional. If empty, a random secret is generated once and kept in the data volume.
SESSION_SECRET=
