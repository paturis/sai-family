rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Approved users live in /admins/{their-google-email-in-lowercase} with a field  role: "admin" | "tech" | "host".
    // Create those documents by hand in the Firebase console. Nobody can create them from the app.
    function role() {
      return get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.role;
    }
    function approved() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }
    function isAdmin() { return approved() && role() == 'admin'; }
    function isStaff() { return approved() && role() in ['admin', 'tech']; }
    function isAnyRole() { return approved() && role() in ['admin', 'tech', 'host']; }

    // Admins manage the team here (the app's Team tab). Nobody can remove or demote themselves.
    match /admins/{email} {
      allow get: if request.auth != null
                 && request.auth.token.email != null
                 && request.auth.token.email.lower() == email;
      allow get, list: if isAdmin();
      allow create, update: if isAdmin()
                 && request.resource.data.keys().hasOnly(['role'])
                 && request.resource.data.role in ['admin', 'tech', 'host']
                 && (email != request.auth.token.email.lower() || request.resource.data.role == 'admin');
      allow delete: if isAdmin() && email != request.auth.token.email.lower();
    }

    // Question bank: staff can read it, only admins can change it.
    match /questions/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Surveys: every approved role can read (the emcee needs the board);
    // admins create and delete; admins and IT techs update (launch, close, load the board).
    match /surveys/{id} {
      allow read: if isAnyRole();
      allow create, delete: if isAdmin();
      allow update: if isStaff();

      // Saved results (raw, groups) are staff only. The live game doc is also readable by the emcee.
      match /data/{name} {
        allow read: if isStaff() || (isAnyRole() && name == 'game');
        allow write: if isStaff();
      }
    }

    // The public scoreboard that the projector and phones watch. It only ever holds what is already on the
    // board (revealed answers, scores, strikes), never hidden answers. Written by staff, readable by anyone signed in.
    match /display/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if isStaff();
    }

    // The live session that phones join. Phones can read one doc by its code (no listing).
    match /live/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update, delete: if isStaff();

      // Phones (anonymous sign-in) may write ONE answer per question, and only while it is open.
      match /answers/{aid} {
        allow read, delete: if isStaff();
        allow create, update: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid', 'q', 'a'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.q is int
          && aid == request.auth.uid + '_' + string(request.resource.data.q)
          && request.resource.data.a is string
          && request.resource.data.a.size() > 0
          && request.resource.data.a.size() <= 80
          && get(/databases/$(database)/documents/live/$(code)).data.phase == 'open'
          && get(/databases/$(database)/documents/live/$(code)).data.q == request.resource.data.q;
      }
    }
  }
}
